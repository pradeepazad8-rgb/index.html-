<!-- ADMISSION -->
<section id="admission">

<h2 class="section-title">Admission Inquiry</h2>

<div class="form-box">

<form onsubmit="sendAdmission(event)">

<label>Student Name</label>
<input type="text" required>

<label>Parent Name</label>
<input type="text" required>

<label>Mobile Number</label>
<input type="tel" required>

<label>Class Required</label>

<select>
<option>Nursery</option>
<option>KG</option>
<option>1st Standard</option>
<option>2nd Standard</option>
<option>3rd Standard</option>
<option>4th Standard</option>
<option>5th Standard</option>
<option>6th Standard</option>
<option>7th Standard</option>
<option>8th Standard</option>
<option>9th Standard</option>
<option>10th Standard</option>
</select>

<label>Message</label>
<textarea placeholder="Write your inquiry"></textarea>

<button type="submit">Submit Inquiry</button>

</form>

</div>

</section>


<!-- LOGIN -->
<section id="login">

<h2 class="section-title">School Portal</h2>

<div class="login-area">

<div class="login-card">

<h3>🎓 Student Login</h3>

<input type="text" placeholder="Student ID">

<input type="password" placeholder="Password">

