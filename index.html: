</div>

</div>

</section>


<!-- FACILITIES -->
<section id="facilities">

<h2 class="section-title">Our Facilities</h2>

<div class="cards">

<div class="card">
<h3>🏫 Safe Campus</h3>
<p>A safe and disciplined learning environment.</p>
</div>

<div class="card">
<h3>👩‍🏫 Teachers</h3>
<p>Dedicated teachers supporting students.</p>
</div>

<div class="card">
<h3>📖 Learning</h3>
<p>Focus on education and student development.</p>
</div>

</div>

</section>


<!-- NOTICE -->
<section>

<h2 class="section-title">Notice Board</h2>

<div class="notice">

