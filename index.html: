<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Blesson Convent High School | Tundri</title>

<style>
*{
  margin:0;
  padding:0;
  box-sizing:border-box;
  font-family:Arial, sans-serif;
}

html{
  scroll-behavior:smooth;
}

body{
  background:#f5f7fb;
  color:#222;
  line-height:1.6;
}

/* HEADER */
header{
  background:#083b7a;
  color:white;
  padding:12px 6%;
  display:flex;
  align-items:center;
  justify-content:space-between;
  flex-wrap:wrap;
  position:sticky;
  top:0;
  z-index:1000;
}

.brand{
  display:flex;
  align-items:center;
  gap:12px;
}

.logo{
  width:65px;
  height:65px;
  border-radius:50%;
  background:white;
  color:#083b7a;
  border:4px solid #f4c542;
  display:flex;
  justify-content:center;
  align-items:center;
  font-weight:bold;
  font-size:18px;
}

.brand h1{
  font-size:22px;
}

.brand p{
  font-size:12px;
}

nav{
  display:flex;
  gap:15px;
  flex-wrap:wrap;
}

nav a{
  color:white;
  text-decoration:none;
  font-size:14px;
}

nav a:hover{
  color:#f4c542;
}

/* HERO */
.hero{
  background:linear-gradient(rgba(8,59,122,.85),rgba(8,59,122,.85));
  color:white;
  text-align:center;
  padding:100px 20px;
}

.hero h2{
  font-size:40px;
  margin-bottom:15px;
}

.hero p{
  font-size:18px;
  margin-bottom:25px;
}

.btn{
  display:inline-block;
  padding:12px 22px;
  background:#f4c542;
  color:#222;
  text-decoration:none;
  border-radius:6px;
  font-weight:bold;
  margin:5px;
}

/* GENERAL */
section{
  padding:60px 8%;
}

.section-title{
  text-align:center;
  color:#083b7a;
  margin-bottom:35px;
  font-size:30px;
}

.center{
  text-align:center;
}

/* CARDS */
.cards{
  display:flex;
  flex-wrap:wrap;
  justify-content:center;
  gap:20px;
}

.card{
  background:white;
  width:300px;
  padding:25px;
  border-radius:12px;
  box-shadow:0 4px 15px rgba(0,0,0,.12);
}

.card h3{
  color:#083b7a;
  margin-bottom:10px;
}

/* PRINCIPAL */
.principal{
  max-width:800px;
  margin:auto;
  background:white;
  padding:30px;
  border-radius:12px;
  box-shadow:0 4px 15px rgba(0,0,0,.1);
}

/* GALLERY */
.gallery{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(250px,1fr));
  gap:20px;
}

.gallery-item{
  height:220px;
  background:#ddd;
  border-radius:12px;
  display:flex;
  align-items:center;
  justify-content:center;
  color:#666;
  overflow:hidden;
}

.gallery-item img{
  width:100%;
  height:100%;
  object-fit:cover;
}

/* NOTICE */
.notice{
  max-width:800px;
  margin:auto;
  background:#fff8d8;
  padding:20px;
  border-left:5px solid #f4c542;
  border-radius:8px;
}

/* FORMS */
.form-box{
  max-width:600px;
  margin:auto;
  background:white;
  padding:30px;
  border-radius:12px;
  box-shadow:0 4px 15px rgba(0,0,0,.12);
}

input, select, textarea{
  width:100%;
  padding:12px;
  margin:8px 0 15px;
  border:1px solid #ccc;
  border-radius:6px;
}

textarea{
  height:120px;
}

button{
  background:#083b7a;
  color:white;
  border:none;
  padding:12px 20px;
  border-radius:6px;
  cursor:pointer;
  font-size:15px;
}

button:hover{
  background:#062b5a;
}

/* LOGIN */
.login-area{
  display:flex;
  justify-content:center;
  gap:30px;
  flex-wrap:wrap;
}

.login-card{
  width:350px;
  background:white;
  padding:30px;
  border-radius:12px;
  box-shadow:0 4px 15px rgba(0,0,0,.12);
  text-align:center;
}

.login-card h3{
  color:#083b7a;
  margin-bottom:15px;
}

/* CONTACT */
.contact{
  background:#083b7a;
  color:white;
}

.contact h2{
  color:#f4c542;
}

/* FOOTER */
footer{
  background:#041f42;
  color:white;
  text-align:center;
  padding:25px;
}

/* MOBILE */
@media(max-width:700px){

header{
  justify-content:center;
  text-align:center;
}

.brand{
  justify-content:center;
}

nav{
  justify-content:center;
  margin-top:15px;
}

.hero h2{
  font-size:28px;
}

section{
  padding:45px 5%;
}

}
</style>
</head>

<body>

<!-- HEADER -->
<header>

<div class="brand">

<div class="logo">BCHS</div>

<div>
<h1>Blesson Convent High School</h1>
<p>Tundri, Bilaigarh, Chhattisgarh</p>
</div>

</div>

<nav>
<a href="#home">Home</a>
<a href="#about">About</a>
<a href="#facilities">Facilities</a>
<a href="#gallery">Gallery</a>
